# Copy to .env; never commit real secrets.
# Generate the client token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OUTDOOR_CLIENT_TOKEN=
# Relative paths resolve from the process working directory. Run from OutDoor_Backend.
OUTDOOR_DATABASE_PATH=data/outdoor.sqlite3

# disabled: AI operations return 503; mock: explicit simulated development only.
# openrouter: live verification of existing non-mock assignments; live generation is not implemented.
OUTDOOR_PROVIDER_MODE=disabled
# Separate server-only credential. Leave empty for disabled/mock mode.
OUTDOOR_OPENROUTER_API_KEY=
# Exact vision-capable Gemma model ID; no default or live model check is supplied.
OUTDOOR_OPENROUTER_VISION_MODEL=
OUTDOOR_OPENROUTER_TIMEOUT_SECONDS=45

# Whole request limit must exceed the per-part upload limit (multipart overhead).
OUTDOOR_MAX_UPLOAD_BYTES=5242880
OUTDOOR_MAX_REQUEST_BYTES=5308416
OUTDOOR_MAX_IMAGE_PIXELS=20000000
OUTDOOR_IMAGE_MAX_DIMENSION=1600
OUTDOOR_IMAGE_JPEG_QUALITY=80

# Dedicated private directory, created at startup with permissions 0700.
# Uploaded files are random, mode 0600, and deleted after reading/on failure.
OUTDOOR_TEMP_IMAGE_DIRECTORY=data/tmp_images
# Stale-file age threshold; active uploads are protected by locks.
OUTDOOR_TEMP_MAX_AGE_SECONDS=3600
# Cleanup also runs at startup; no cleanup runs while the server is stopped.
OUTDOOR_TEMP_CLEANUP_INTERVAL_SECONDS=60
